<Window x:Class="KeepHistory.Views.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="サードパーティーのライセンス"
        Width="640" Height="520" MinWidth="400" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}"
        FocusManager.FocusedElement="{Binding ElementName=CloseButton}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CloseButton" Content="閉じる" IsDefault="True" IsCancel="True"
                    Style="{StaticResource DialogButtonStyle}" />
        </StackPanel>
        <TextBox x:Name="NoticeText" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                 TextWrapping="NoWrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas, MS Gothic" Padding="6"
                 Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" />
    </DockPanel>
</Window>
