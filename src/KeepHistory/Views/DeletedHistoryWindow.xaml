<Window x:Class="KeepHistory.Views.DeletedHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="外した履歴を戻す"
        Width="720" Height="440" MinWidth="480" MinHeight="280"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FocusManager.FocusedElement="{Binding ElementName=DeletedGrid}">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource SubTextStyle}" Margin="0,0,0,8"
                   Text="一覧から外したファイルです（パソコンのファイルは削除していません）。選んで「元に戻す」を押すと、一覧に戻ります（すぐに反映され、キャンセルはできません）。" />
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="閉じる" IsCancel="True"
                    Style="{StaticResource DialogButtonStyle}" />
            <Button x:Name="RestoreButton" DockPanel.Dock="Right" Content="元に戻す" IsDefault="True"
                    Style="{StaticResource DialogButtonStyle}" Click="OnRestoreClick" />
            <TextBlock x:Name="ResultText" VerticalAlignment="Center" Style="{StaticResource SubTextStyle}" />
        </DockPanel>
        <Grid>
            <DataGrid x:Name="DeletedGrid" AutomationProperties.Name="外した履歴" Style="{StaticResource HistoryGridStyle}"
                      CellStyle="{StaticResource HistoryCellStyle}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Extended" SelectionUnit="FullRow"
                      SelectionChanged="OnSelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ファイル名" Binding="{Binding FileName}" Width="220"
                                        ElementStyle="{StaticResource CellTextStyle}" />
                    <DataGridTextColumn Header="フォルダ" Binding="{Binding FolderPath}" Width="*"
                                        ElementStyle="{StaticResource CellTextStyle}" />
                    <DataGridTextColumn Header="外した日時" Binding="{Binding DeletedAtText}" SortMemberPath="DeletedAt"
                                        Width="130" ElementStyle="{StaticResource CellTextStyle}" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="EmptyText" Text="外した履歴はありません。" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Style="{StaticResource SubTextStyle}" Visibility="Collapsed" />
        </Grid>
    </DockPanel>
</Window>
