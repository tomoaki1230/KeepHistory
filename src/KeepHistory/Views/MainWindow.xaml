<Window x:Class="KeepHistory.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KeepHistory.Views"
        Title="{x:Static local:MainWindow.DefaultTitle}"
        Width="960" Height="600" MinWidth="520" MinHeight="300"
        WindowStartupLocation="Manual"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FocusManager.FocusedElement="{Binding ElementName=SearchBox}"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        KeyDown="OnWindowKeyDown">

    <DockPanel>
    <!-- メニューバー -->
    <Menu x:Name="MainMenu" DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}"
          BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,2">
        <!-- 表示（一覧の見せ方。チェックを付け外しすると、その場で反映して設定に保存する） -->
        <MenuItem x:Name="ViewMenu" Header="表示(_V)">
            <MenuItem x:Name="GroupByDateMenuItem" Header="一覧を日付でまとめる(_G)" IsCheckable="True"
                      IsChecked="{Binding GroupByDate}"
                      ToolTip="前回利用日時で並べているとき、「今日」「昨日」「今週」などの見出しで区切ります" />
            <MenuItem x:Name="HideMissingFilesMenuItem" Header="削除済みのローカルファイルを表示しない(_M)" IsCheckable="True"
                      IsChecked="{Binding HideMissingFiles}"
                      ToolTip="削除・移動などで見つからないファイル（薄い色の行）を一覧に出しません。ネットワーク上のファイルと、キープしたファイルは表示します（履歴からは消しません）" />
            <MenuItem x:Name="HideNetworkFilesMenuItem" Header="ネットワーク上のファイルを表示しない(_N)" IsCheckable="True"
                      IsChecked="{Binding HideNetworkFiles}"
                      ToolTip="共有フォルダ（\\サーバー\…）や、割り当てたネットワークドライブのファイルを一覧に出しません。キープしたファイルは表示します（履歴からは消しません）" />
        </MenuItem>
        <MenuItem x:Name="ToolsMenu" Header="ツール(_T)">
            <MenuItem x:Name="ExportKeptCsvMenuItem" Header="キープの一覧を CSV に出力(_E)..." Click="OnExportKeptCsvClick"
                      ToolTip="キープしたファイルをすべて（絞り込みにかかわらず）、Excel で開ける CSV ファイルに保存します" />
            <Separator />
            <MenuItem x:Name="SettingsMenuItem" Header="設定(_O)..." Click="OnSettingsClick" />
        </MenuItem>
        <MenuItem x:Name="HelpMenu" Header="ヘルプ(_H)">
            <MenuItem x:Name="ThirdPartyLicensesMenuItem" Header="サードパーティーのライセンス(_L)"
                      Click="OnThirdPartyLicensesClick" />
            <Separator />
            <MenuItem x:Name="AboutMenuItem" Header="バージョン情報(_A)" Click="OnAboutClick" />
        </MenuItem>
    </Menu>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 検索と絞り込み（タブは使わない） -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="True">
            <!-- 強制リフレッシュ（「キープのみ」の右） -->
            <Button x:Name="RefreshButton" AutomationProperties.Name="更新" DockPanel.Dock="Right"
                    Style="{StaticResource ToolbarButtonStyle}" Click="OnRefreshClick"
                    ToolTip="「最近使った項目」を読み直し、ファイルが見つかるかを確かめ直して一覧を作り直します">
                <StackPanel Orientation="Horizontal">
                    <!-- E72C = Refresh -->
                    <TextBlock x:Name="RefreshIcon" Text="&#xE72C;" Style="{StaticResource ToolbarIconStyle}" />
                    <TextBlock Text="更新" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <ToggleButton x:Name="KeptOnlyToggle" AutomationProperties.Name="キープのみ" DockPanel.Dock="Right"
                          IsChecked="{Binding KeptOnly}" Style="{StaticResource ToolbarButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="KeptOnlyStar" Style="{StaticResource KeptOnlyStarStyle}" />
                    <TextBlock Text="キープのみ" VerticalAlignment="Center" />
                </StackPanel>
            </ToggleButton>
            <ComboBox x:Name="PeriodBox" AutomationProperties.Name="期間で絞り込む" DockPanel.Dock="Right" Width="120"
                      ItemsSource="{Binding PeriodChoices}" SelectedItem="{Binding SelectedPeriod}"
                      DisplayMemberPath="Label" Style="{StaticResource ToolbarComboStyle}" />
            <ComboBox x:Name="ExtensionBox" AutomationProperties.Name="種類で絞り込む" DockPanel.Dock="Right" Width="130"
                      ItemsSource="{Binding ExtensionChoices}" SelectedItem="{Binding SelectedExtension}"
                      DisplayMemberPath="Label" Style="{StaticResource ToolbarComboStyle}" />
            <Grid>
                <!-- 右の余白（56）は「×」（ClearSearchButtonSize 24 + 余白 3）と「▾」（SearchDropDownButtonWidth 26 + 枠 1）に文字が隠れないため -->
                <TextBox x:Name="SearchBox" AutomationProperties.Name="ファイル名・パスで検索" Style="{StaticResource SearchBoxStyle}"
                         Padding="6,0,56,0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         PreviewKeyDown="OnSearchBoxPreviewKeyDown" />
                <TextBlock Text="ファイル名・パスで検索（スペース区切りで AND）">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource PlaceholderTextStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text.Length, ElementName=SearchBox}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- 検索欄の右端のボタン。右端が「▾」（最近の検索語。常に出す）、その左が「×」（検索語があるとき） -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- 検索語を消す（検索語があるときだけ出す） -->
                    <Button x:Name="ClearSearchButton" Click="OnClearSearchClick">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ClearSearchButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text.Length, ElementName=SearchBox}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <!-- 最近の検索語（覚えている語が無ければ押せない） -->
                    <Button x:Name="RecentSearchButton" Click="OnRecentSearchClick">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SearchDropDownButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RecentSearches.Items.Count}" Value="0">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
                <!-- 最近の検索語（検索欄の下に出す。選ぶとその語で検索する。いちばん下に「履歴を消す」） -->
                <Popup x:Name="RecentSearchPopup" PlacementTarget="{Binding ElementName=SearchBox}" Placement="Bottom"
                       StaysOpen="False" AllowsTransparency="False"
                       Width="{Binding ActualWidth, ElementName=SearchBox}">
                    <Border Background="{DynamicResource PopupBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <DockPanel>
                            <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="0,1,0,0" Padding="2">
                                <Button x:Name="ClearRecentSearchesInListButton" Content="履歴を消す"
                                        AutomationProperties.Name="検索語の履歴を消す" ToolTip="覚えている検索語をすべて消します"
                                        Style="{StaticResource PopupLinkButtonStyle}" Click="OnClearRecentSearchesInListClick"
                                        PreviewKeyDown="OnRecentSearchListPreviewKeyDown" />
                            </Border>
                            <ListBox x:Name="RecentSearchList" AutomationProperties.Name="最近の検索語の一覧"
                                     Style="{StaticResource RecentSearchListStyle}" MaxHeight="260"
                                     ItemsSource="{Binding RecentSearches.Items}"
                                     PreviewKeyDown="OnRecentSearchListPreviewKeyDown"
                                     PreviewMouseLeftButtonUp="OnRecentSearchListMouseUp" />
                        </DockPanel>
                    </Border>
                </Popup>
            </Grid>
        </DockPanel>

        <!-- フォルダで絞り込んでいるとき（右クリックの「このフォルダのファイルを表示」）の帯 -->
        <Border x:Name="FolderFilterBar" Grid.Row="1" Style="{StaticResource FolderFilterBarStyle}">
            <Border.Visibility>
                <Binding Path="FolderFilterText" Converter="{StaticResource NullToCollapsedConverter}" />
            </Border.Visibility>
            <DockPanel>
                <Button x:Name="ClearFolderFilterButton" DockPanel.Dock="Right" Content="解除" AutomationProperties.Name="フォルダの絞り込みを解除"
                        Height="24" Padding="12,0" Style="{StaticResource ToolbarButtonStyle}" Click="OnClearFolderFilterClick" />
                <TextBlock x:Name="FolderFilterText" Text="{Binding FolderFilterText}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Style="{StaticResource BaseTextStyle}"
                           ToolTip="{Binding FolderFilter}" />
            </DockPanel>
        </Border>

        <!--
          一覧。並び替えは列見出しのクリックのみ。前回利用日時で並べているときは日付でまとめる（設定）。
          選択は一覧の「現在の項目」に合わせない（合わせると、まとめ直したときに勝手に行が選ばれ、検索欄の Enter がその行を開いてしまう）
        -->
        <DataGrid x:Name="HistoryGrid" AutomationProperties.Name="履歴の一覧" Grid.Row="2"
                  Style="{StaticResource HistoryGridStyle}"
                  RowStyle="{StaticResource HistoryRowStyle}"
                  CellStyle="{StaticResource HistoryCellStyle}"
                  ItemsSource="{Binding View}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  CanUserSortColumns="True" CanUserReorderColumns="True" CanUserResizeColumns="True"
                  EnableRowVirtualization="True"
                  VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                  IsSynchronizedWithCurrentItem="False"
                  MouseDoubleClick="OnGridMouseDoubleClick"
                  PreviewMouseLeftButtonDown="OnGridPreviewMouseLeftButtonDown"
                  PreviewMouseMove="OnGridPreviewMouseMove"
                  PreviewMouseLeftButtonUp="OnGridPreviewMouseLeftButtonUp"
                  PreviewKeyDown="OnGridPreviewKeyDown"
                  SelectionChanged="OnGridSelectionChanged">
            <DataGrid.GroupStyle>
                <GroupStyle HeaderTemplate="{StaticResource DateGroupHeaderTemplate}" />
            </DataGrid.GroupStyle>
            <DataGrid.ContextMenu>
                <ContextMenu Opened="OnContextMenuOpened">
                    <MenuItem Header="開く" InputGestureText="Enter" FontWeight="Bold" Click="OnOpenClick" />
                    <MenuItem x:Name="OpenWithMenuItem" Header="プログラムから開く..." Click="OnOpenWithClick" />
                    <MenuItem Header="フォルダを開く" InputGestureText="Ctrl+Enter" Click="OnOpenFolderClick" />
                    <MenuItem x:Name="ShowFolderFilesMenuItem" Header="このフォルダのファイルを表示" Click="OnShowFolderFilesClick" />
                    <Separator />
                    <MenuItem x:Name="CopyFileMenuItem" Header="ファイルをコピー" Click="OnCopyFileClick" />
                    <MenuItem Header="パスをコピー" InputGestureText="Ctrl+C" Click="OnCopyPathClick" />
                    <MenuItem x:Name="CopyFileNameMenuItem" Header="ファイル名をコピー" Click="OnCopyFileNameClick" />
                    <Separator />
                    <MenuItem x:Name="ExcludeFileMenuItem" Header="このファイルを記録しない" Click="OnExcludeFileClick" />
                    <MenuItem x:Name="ExcludeFolderMenuItem" Header="このフォルダ（サブフォルダを含む）を記録しない" Click="OnExcludeFolderClick" />
                    <MenuItem x:Name="ExcludeExtensionMenuItem" Header="この拡張子を記録しない" Click="OnExcludeExtensionClick" />
                    <Separator />
                    <MenuItem Header="★ キープの切り替え" InputGestureText="Ctrl+K" Click="OnToggleKeepClick" />
                    <Separator />
                    <!-- 「削除」だとファイルが消えると誤解されやすいので「一覧から外す」と言う（ファイルには触れない） -->
                    <MenuItem x:Name="RemoveFromListMenuItem" Header="一覧から外す" InputGestureText="Delete" Click="OnDeleteClick"
                              ToolTip="一覧から外すだけで、パソコンのファイルは削除しません（Ctrl+Z で戻せます）" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="キープ" SortMemberPath="IsKept" Width="40" CanUserResize="False"
                                        HeaderStyle="{StaticResource KeepColumnHeaderStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource KeepStarButtonStyle}" Click="OnKeepButtonClick" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- ファイル名とフォルダは、検索語に一致した部分を強調する -->
                <DataGridTemplateColumn Header="ファイル名" SortMemberPath="FileName" Width="260">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!-- 先頭にファイルの種類のアイコン（拡張子から求める。ファイルにはアクセスしない） -->
                            <DockPanel>
                                <Image x:Name="FileIcon" DockPanel.Dock="Left" Width="16" Height="16" Margin="6,0,0,0"
                                       VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"
                                       Source="{Binding Extension, Converter={StaticResource FileIconConverter}}" />
                                <TextBlock Style="{StaticResource CellTextStyle}"
                                           local:SearchHighlight.Text="{Binding FileName}"
                                           local:SearchHighlight.Terms="{Binding DataContext.HighlightTerms, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                            </DockPanel>
                            <DataTemplate.Triggers>
                                <!-- 見つからないファイルは、文字と同じくアイコンも淡くする -->
                                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                    <Setter TargetName="FileIcon" Property="Opacity" Value="0.45" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="フォルダ" SortMemberPath="FolderPath" Width="380">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource CellTextStyle}"
                                       local:SearchHighlight.Text="{Binding FolderPath}"
                                       local:SearchHighlight.Terms="{Binding DataContext.HighlightTerms, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="前回利用日時" Binding="{Binding LastUsedText}" SortMemberPath="LastUsed"
                                    Width="140" ElementStyle="{StaticResource CellTextStyle}" />
                <DataGridTextColumn Header="回数" Binding="{Binding OpenCount}" SortMemberPath="OpenCount"
                                    Width="60" ElementStyle="{StaticResource CellNumberStyle}" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- 一覧が空のときの案内（履歴が無い／絞り込みで 0 件） -->
        <TextBlock x:Name="EmptyMessageText" Grid.Row="2" Text="{Binding EmptyMessage}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                   IsHitTestVisible="False" Style="{StaticResource SubTextStyle}" FontSize="13">
            <TextBlock.Visibility>
                <Binding Path="EmptyMessage" Converter="{StaticResource NullToCollapsedConverter}" />
            </TextBlock.Visibility>
        </TextBlock>

        <DockPanel Grid.Row="3" Margin="0,8,0,0">
            <TextBlock x:Name="KeyHintText" DockPanel.Dock="Right" Style="{StaticResource SubTextStyle}"
                       Text="Enter: 開く　Ctrl+Enter: フォルダ　Ctrl+K: キープ　Delete: 一覧から外す　Ctrl+Z: 元に戻す　Esc: 閉じる" />
            <TextBlock x:Name="StatusText" DockPanel.Dock="Left" Style="{StaticResource SubTextStyle}" Text="{Binding StatusText}" />
            <!-- 開こうとしたファイルが見つからないときなどのメッセージ（赤字）。ダイアログを出さずキーボード操作を続けられるように -->
            <TextBlock x:Name="StatusMessageText" Margin="16,0,12,0" FontSize="11.5"
                       Foreground="{DynamicResource ErrorBrush}" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Visibility="Collapsed" />
        </DockPanel>
    </Grid>
    </DockPanel>
</Window>
