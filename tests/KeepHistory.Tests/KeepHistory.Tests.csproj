<!--
  NuGet 参照ゼロの自作テスト基盤。
  テストはコンソール実行ファイルとしてビルドし、`dotnet test` から呼ばれる VSTest ターゲットを
  下で上書きして、この実行ファイルを起動する。
  起動は exe（アプリホスト）ではなく dotnet から dll を実行する形にする（署名の無い exe は、Windows のアプリ制御
  （Smart App Control / Device Guard）で起動を止められることがあるため。署名済みの dotnet からなら動く）。
  （VSTest ターゲットを SDK の定義より後に置くため、Sdk を明示的に Import している）
-->
<Project>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>KeepHistory.Tests</RootNamespace>
    <AssemblyName>KeepHistory.Tests</AssemblyName>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\KeepHistory\KeepHistory.csproj" />
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

  <!--
    dotnet test から呼ばれる。自作ランナーを実行し、終了コードで成否を返す。
    DOTNET_HOST_PATH は dotnet コマンドから MSBuild を動かすと入る、いま動いている dotnet のフルパス（無ければ PATH の dotnet）。
  -->
  <PropertyGroup>
    <KeepHistoryDotnetHost>$(DOTNET_HOST_PATH)</KeepHistoryDotnetHost>
    <KeepHistoryDotnetHost Condition="'$(KeepHistoryDotnetHost)' == ''">dotnet</KeepHistoryDotnetHost>
  </PropertyGroup>

  <Target Name="VSTest" DependsOnTargets="Build">
    <Exec Command="&quot;$(KeepHistoryDotnetHost)&quot; &quot;$(TargetDir)$(TargetName).dll&quot; $(KeepHistoryTestFilter)"
          WorkingDirectory="$(TargetDir)"
          StandardOutputImportance="high"
          StandardErrorImportance="high"
          StdOutEncoding="utf-8"
          StdErrEncoding="utf-8"
          IgnoreStandardErrorWarningFormat="true"
          CustomErrorRegularExpression="^\[失敗\]" />
  </Target>

</Project>
