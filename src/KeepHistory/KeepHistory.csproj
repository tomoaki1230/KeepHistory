<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- WPF と WinForms（通知領域アイコン）を併用する -->
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF と WinForms の名前空間が衝突するため、暗黙の using は使わない -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>KeepHistory</RootNamespace>
    <AssemblyName>KeepHistory</AssemblyName>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Version>1.1.0</Version>
    <!-- 作成者（バージョン情報に表示する。アセンブリの Company 属性になる） -->
    <Authors>Tomoaki Bessho</Authors>
    <Company>Tomoaki Bessho</Company>
    <!-- exe のアイコン（エクスプローラー・スタートメニューなど） -->
    <ApplicationIcon>Assets\KeepHistory.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- ウインドウと通知領域のアイコン。元画像 icon.png から tools/make-icon.ps1 で生成する -->
    <Resource Include="Assets\KeepHistory.ico" />
    <!-- ヘルプ ＞ サードパーティーのライセンス で表示する -->
    <Resource Include="Licenses\THIRD-PARTY-NOTICES.txt" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KeepHistory.Tests" />
  </ItemGroup>

</Project>
